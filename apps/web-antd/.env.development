# 端口号
VITE_PORT=5666

VITE_BASE=/

# 接口地址：透过 vite dev-server 的 /api 代理指向 spring-agent-boot 后端。
# 代理会把 /api 前缀 rewrite 掉,后端 spring-agent.web.base-path 也是空 —— 端点全部
# 挂在根路径,前后统一。改动这里请同步 vite.config.mts 的 /api rewrite 规则。
VITE_GLOB_API_URL=/api

# 关闭 Nitro Mock，直连真实后端
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# ================== 聊天调试 iframe (antd-react-chat) ==================
# 挂 iframe 的基础路径。默认 /chat/，配合 vite dev-server 的 /chat 代理即可
# 同源；如果不想代理，改成绝对地址（例如 http://localhost:5073/chat/）——
# 注意跨域会关掉 ChatIframePanel 的 localStorage 调试参数通道。
VITE_CHAT_IFRAME_BASE=/chat/

# antd-react-chat dev server 地址；开发时 vite 代理 /chat 和 /chatapi 都指向它
VITE_CHAT_IFRAME_DEV_TARGET=http://localhost:5073

# 全站兜底的 Dify App Key —— 后端 AgentEntity 未携带 difyApiKey 字段时用它。
# 生产建议改由后端注入，避免明文写在打包产物里。
VITE_DIFY_APP_KEY=
