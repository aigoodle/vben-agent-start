VITE_BASE=/

# 接口地址：生产环境默认由同源网关把 /api 转发到 spring-agent-start。
# 如前后端分离部署，可在构建环境中覆盖为完整的后端地址。
VITE_GLOB_API_URL=/api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
